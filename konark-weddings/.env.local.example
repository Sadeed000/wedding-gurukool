# MongoDB
MONGODB_URI=mongodb://localhost:27017/konark-weddings
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/konark-weddings

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Admin credentials (for seeding)
ADMIN_EMAIL=admin@konarkweddings.com
ADMIN_PASSWORD=Admin@123456

# Email (Nodemailer - Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Wedding Gurukuls <noreply@konarkweddings.com>

# Contact email recipient
CONTACT_EMAIL=weddinggurukuljpr@gmail.com

# Optional: Cloudinary for image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Wedding Gurukuls
